# AniTech Environment Configuration
# Copy this file to .env and adjust values for your environment

# --- Database ---
DATABASE_URL=postgresql://anitech:anitech_secret@localhost:5432/anitech
DB_PASSWORD=anitech_secret

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=anitech_search_key

# --- Auth ---
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Server ---
PORT=4000
WS_PORT=4001
WS_URL=http://localhost:4001
NODE_ENV=development

# --- App ---
APP_VERSION=0.1.0
ANALYTICS_ENABLED=true

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# --- Sync ---
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=